# =============================================================================
# Linux Sentinel — project ignore rules
# All rules for this project live here; no repo-root or per-directory files.
# Public repository: no build artifacts, samples, keys or telemetry.
# =============================================================================

# --- Runtime and private directories ---
# private dev tree: staging, planning, release CI, rollbacks
internal_dev/
# TLS material, generated by run.sh:32
certs/
# TLS material, generated by run_with_dashboard.sh:83
dashboard/certs/
# dashboard SQLite state, run_with_dashboard.sh:84
dashboard/data/
# YARA/Sigma/blocklists/vmlinux.h, staged at deploy
intel_staging/
# agent runtime state: sentinel.db, baselines.db, parquet/
sentinel-data/
# generated forensic output
reports/

# --- Rust ---
# Cargo.lock IS committed: this crate builds a binary.
target/
**/target/
*.rs.bk
*.pdb

# --- eBPF / native build output ---
*.bpf.o
*.skel.h
# build.rs generates this from the BUILDING host's kernel when absent. Committing
# one machine's copy pins every later build to that kernel's struct layout.
src/bpf/vmlinux.h
**/src/bpf/vmlinux.h
vmlinux.h.generated
*.o
*.a
*.so
*.so.*
*.dylib

# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing artifacts ---
.pytest_cache/
**/.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
junit*.xml
test-results/
test-output/

# --- Corpus captures and lab evidence: large, host-identifying, often real malware ---
corpus/
corpora/
lab_output/
evidence/
*.pcap
*.pcapng
*.core
core.[0-9]*

# --- Release promotion archives ---
**/ci/rollback/

# --- Secrets, certificates, keys: second line after the certs/ excludes above ---
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.gpg
*.asc
!*.pub
.env
.env.*
!.env.example
!.env.template
*.secret
*_token
credentials.json

# --- Databases and telemetry stores ---
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.wal
*.shm
*.parquet
*.arrow
*.feather

# --- Logs and diagnostics ---
*.log
*.log.*
logs/
diagnostics/
*.out
nohup.out

# --- Threat intel staged outside intel_staging/ ---
*.yar.gz
*.tar.zst
rules_downloaded/

# --- Scratch and editor leftovers ---
scratch/
sandbox/
wip/
*.orig
*.rej
*.bak
*.tmp
*~
*.swp
*.swo

# --- Containers ---
.docker/
docker-compose.override.yaml
docker-compose.override.yml
*.tar.gz.part

# --- Node (dashboard front-end) ---
node_modules/
.npm/
.yarn/
*.tsbuildinfo

# --- Editors and OS ---
.idea/
.vscode/
*.iml
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
.claude/
